{
  "name": "lanceglass",
  "version": "26.9.1-alpha.1401",
  "private": true,
  "description": "A local-first looking glass for Claude Code and Codex JSONL histories, powered by LanceDB.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soul-Brews-Studio/lanceglass.git"
  },
  "keywords": [
    "lancedb",
    "jsonl",
    "claude-code",
    "codex",
    "agent-history",
    "vector-database"
  ],
  "type": "module",
  "scripts": {
    "cli": "bun src/cli.ts",
    "ui": "bun run ui:build && bun src/server.ts",
    "ui:build": "vite build",
    "ui:dev": "vite --host 127.0.0.1 --port 4321",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version:check": "bun scripts/check-version.ts",
    "smoke": "bun run version:check && bun run typecheck && bun run ui:build && bun run test && bun scripts/smoke.ts",
    "maw:build": "bun run version:check && bun scripts/build-maw-plugin.ts",
    "maw:install": "bun run maw:build && maw plugin install maw-plugin/dist --force"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lancedb/lancedb": "0.27.2",
    "apache-arrow": "18.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
