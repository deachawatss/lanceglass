  "cards": [
    {
      "dot": "emerald",
      "title": "Idempotent plain intake",
      "items": [
        "Source-file manifest separates new, changed, known, and reconcile states.",
        "Stable event and provenance IDs make retries safe across bounded 5,000-block commits."
      ]
    },
    {
      "dot": "violet",
      "title": "Embedding is derived and opt-in",
      "items": [
        "Import never opens the vector store or calls Ollama.",
        "A later bounded pass pages plain rows, validates bge-m3 output, and commits durable vector batches."
      ]
    },
    {
      "dot": "amber",
      "title": "Local-first boundary",
      "items": [
        "The Bun server binds to localhost; plain and vector LanceDB stores are physically separate.",
        "Job history is in-memory; imported rows and optional vectors survive server restarts."
      ]
    }
  ]
